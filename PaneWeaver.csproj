<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>assets\paneweaver.ico</ApplicationIcon>
    <AssemblyName>PaneWeaver</AssemblyName>
    <RootNamespace>PaneWeaver</RootNamespace>
    <Version>1.1.0</Version>
    <Company>PaneWeaver</Company>
    <Product>PaneWeaver</Product>
    <Description>Every folder, one native Explorer window.</Description>
    <Authors>DopaLab</Authors>
    <Copyright>Copyright © 2026 DopaLab</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DopaLab/PaneWeaver</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DopaLab/PaneWeaver.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <InternalsVisibleTo Include="PaneWeaver.Tests" />
    <None Include="assets\paneweaver.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
